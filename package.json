{
  "name": "warmly",
  "version": "2.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "dev": "expo start",
    "prebuild:android": "expo prebuild --platform android --clean",
    "setup:android": "bash scripts/setup-android.sh",
    "build:apk": "eas build -p android --profile preview",
    "build:apk:local": "expo prebuild --platform android && bash scripts/setup-android.sh && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@expo-google-fonts/literata": "^0.4.3",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/metro-runtime": "^58.0.17",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-uuid": "^2.0.2",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.24",
    "typescript": "~6.0.3"
  }
}
